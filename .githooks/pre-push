#!/bin/sh
# The messages of commits no remote holds yet pass `privacy.sh text`, however they reached the branch being pushed.
privacy="$(git rev-parse --show-toplevel)/scripts/privacy.sh"
while read -r local_ref local_sha _ _; do
    # A deleted ref arrives as all zeros and pushes no commits.
    case $local_sha in *[!0]*) ;; *) continue ;; esac
    if ! git log --format=%B "$local_sha" --not --remotes | sh "$privacy" text; then
        echo "hitodama: a commit message pushed to $local_ref holds what privacy.sh refuses; reword it" >&2
        exit 1
    fi
done
exit 0
