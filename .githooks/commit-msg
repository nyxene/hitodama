#!/bin/sh
# release-please derives the version and changelog from this; regex shared with the pull request check.
top=$(git rev-parse --show-toplevel)
subject=$(sed -n '/./{p;q;}' "$1")
regex=$(cat "$top/scripts/subject.regex")
if ! printf '%s\n' "$subject" | grep -Eq "$regex"; then
    echo "hitodama: commit subject must be conventional: type(scope): text" >&2
    echo "          types: feat fix docs chore refactor perf test build ci revert" >&2
    echo "          got:   $subject" >&2
    exit 1
fi
# The diff below a `git commit -v` scissors line is never kept. Comment lines are checked too: `-m` and `-F` keep
# them (a Markdown heading is one), and git's own template comments hold nothing these checks refuse.
message=$(sed '/^# -\{24\} >8 -\{24\}$/,$d' "$1")
# A private Claude link points at a conversation or page nobody else can open.
if printf '%s\n' "$message" | grep -q -E '^Claude-Session:|claude\.ai/(code|artifact|chat|share|project)'; then
    echo "hitodama: remove the private Claude link (and any Claude-Session line) from the commit message" >&2
    exit 1
fi
# The words listed in .git/info/private-words stay out of every message; pre-push checks the messages again, for
# commits made where this hook did not run.
if ! printf '%s\n' "$message" | sh "$top/scripts/privacy.sh" text; then
    echo "hitodama: remove those words from the commit message" >&2
    exit 1
fi
